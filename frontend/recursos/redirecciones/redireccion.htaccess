# REDIRECCIONAMIENTO .htaccess
# Reemplaza "http://3.12.148.33/plantas/" con la URL real del servidor universitario

# Opción 1: Redirección usando mod_rewrite (Más flexible)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP_HOST} ^tudominio.universidad.edu$ [NC]
    RewriteRule ^(.*)$ http://3.12.148.33/plantas/$1 [R=301,L]
</IfModule>

# Opción 2: Redirección Simple (Si la opción 1 falla)
# Descomenta la siguiente línea si prefieres usar esta:
# Redirect 301 / http://3.12.148.33/plantas/